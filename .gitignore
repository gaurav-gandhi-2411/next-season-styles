# Data (raw/interim/processed are gitignored; .gitkeep keeps the dirs tracked)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
