# Data (raw/interim/processed/images are gitignored; .gitkeep keeps the dirs tracked)
data/raw/*
data/interim/*
data/processed/*
data/images/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/images/.gitkeep
data/generated/
data/retrieval_cache/
# rembg's u2net.onnx (176 MB), downloaded on first use; model weights are never committed
data/rembg_models/
# nss.prod outputs: trained artifacts, the local registry and scoring logs are data, not source
data/artifacts/
data/registry/
data/logs/

# scripts/run_pipeline.py's scoped-down (1-2 seed) generate/score/hero output -- isolated from
# the real reports/tables/final_concepts.csv, reports/tables/concept_qc_results.csv, and
# reports/figures/FINAL_concepts.png|evidence_chain.png, which remain the authoritative,
# committed C6-C8 deliverables (see that script's module docstring STAGE-OUTPUT ISOLATION).
reports/pipeline_run/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets (GEMINI_API_KEY etc.) -- never commit
.env

# GCP service account keys -- never commit; vertex-sa.json is the Phase 5 Vertex AI credential
vertex-sa.json
*-sa.json
*service-account*.json
dist/

# Track U scratch (regenerable; per-style-week customer aggregates and scratch boosters, never committed)
reports/u_scratch/
models_scratch/
